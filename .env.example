# Add your Cerebras API key here
CEREBRAS_API_KEY=

# Add your Tavily API key here
TAVILY_API_KEY=

# Optional: add your Semantic Scholar API key here
SEMANTIC_SCHOLAR_API_KEY=

# Optional: NVIDIA NIM / build.nvidia.com API key
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k2.6

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Free local TTS. The high voice is larger, but sounds more natural once cached.
VOICE_PROVIDER=piper
PIPER_VOICE_ID=en_US-lessac-high
PIPER_CACHE_DIR=.cache/piper
PIPER_AUTO_DOWNLOAD=true
PIPER_MAX_CHARS=520

# Local voice input fallback used when browser speech recognition is unreachable.
STT_MODEL=tiny.en
STT_LANGUAGE=en
STT_COMPUTE_TYPE=int8
STT_MAX_UPLOAD_BYTES=15000000
